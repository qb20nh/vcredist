{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Pack verified input lockfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "supportedDotnetCycles", "inputs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "supportedDotnetCycles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["8", "9", "10"] }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/input" }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "feature", "architecture", "fileName", "sourceUrl", "sha256", "sha512", "size", "version", "signerSubjectContains", "installArguments", "detectCondition", "licenseUrl"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "feature": { "enum": ["vc-redist-v14", "dotnet-desktop", "dotnet-aspnet", "dotnet-framework", "dotnet-framework-35", "directx-legacy"] },
        "cycle": { "enum": ["8", "9", "10"] },
        "architecture": { "enum": ["x86", "x64", "arm64"] },
        "fileName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "sha512": { "type": "string", "pattern": "^[A-Fa-f0-9]{128}$" },
        "size": { "type": "integer", "minimum": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$" },
        "signerSubjectContains": { "const": "Microsoft Corporation" },
        "installArguments": { "type": "string" },
        "detectCondition": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "inPlaceRank": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "feature": { "enum": ["dotnet-desktop", "dotnet-aspnet"] } } },
          "then": { "required": ["cycle"] }
        },
        {
          "if": { "properties": { "feature": { "const": "dotnet-framework" } } },
          "then": { "required": ["inPlaceRank"] }
        }
      ]
    }
  }
}
